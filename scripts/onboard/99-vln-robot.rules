# /etc/udev/rules.d/99-vln-robot.rules  (installed by scripts/onboard/03_udev.sh)

# WHEELTEC G60 GNSS. The CH9102F serial number must be set to 0005 with CH34xSerCfg.exe on Windows
# (see vendor/wheeltec_g60/manuals, section 3.1). Ubuntu 22.04 binds CH9102 (1a86:55d4) to cdc_acm
# (/dev/ttyACM*); the vendor CH343 driver creates /dev/ttyCH343USB*; older units use CP2102 (/dev/ttyUSB*).
KERNEL=="ttyACM*",       ATTRS{idVendor}=="1a86", ATTRS{idProduct}=="55d4", ATTRS{serial}=="0005", MODE:="0666", GROUP:="dialout", SYMLINK+="wheeltec_gps"
KERNEL=="ttyCH343USB*",  ATTRS{idVendor}=="1a86", ATTRS{idProduct}=="55d4", ATTRS{serial}=="0005", MODE:="0666", GROUP:="dialout", SYMLINK+="wheeltec_gps"
KERNEL=="ttyUSB*",       ATTRS{idVendor}=="10c4", ATTRS{idProduct}=="ea60", ATTRS{serial}=="0005", MODE:="0666", GROUP:="dialout", SYMLINK+="wheeltec_gps"

# USB webcam: stable /dev/vln_cam symlink. Fill in idVendor/idProduct from `lsusb`
# (or `udevadm info -a -n /dev/video0`). ATTR{index}=="0" picks the capture node, not the metadata node.
# SUBSYSTEM=="video4linux", ATTRS{idVendor}=="xxxx", ATTRS{idProduct}=="yyyy", ATTR{index}=="0", MODE:="0666", SYMLINK+="vln_cam"
SUBSYSTEM=="video4linux", KERNEL=="video0", ATTR{index}=="0", MODE:="0666", SYMLINK+="vln_cam"
