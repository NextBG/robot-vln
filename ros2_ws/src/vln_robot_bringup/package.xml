<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>vln_robot_bringup</name>
  <version>0.1.0</version>
  <description>Bringup (launch + config) for the RoboMaster S1 VLN robot: chassis, USB webcam, Livox Mid-360, WHEELTEC G60 GNSS.</description>
  <maintainer email="nextb@example.com">NextBG</maintainer>
  <license>MIT</license>

  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>tf2_ros</exec_depend>
  <exec_depend>robomaster_ros</exec_depend>
  <exec_depend>usb_cam</exec_depend>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>python3-opencv</exec_depend>
  <exec_depend>python3-yaml</exec_depend>
  <exec_depend>livox_ros_driver2</exec_depend>
  <exec_depend>nmea_navsat_driver</exec_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
