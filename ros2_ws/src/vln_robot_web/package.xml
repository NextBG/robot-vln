<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>vln_robot_web</name>
  <version>0.1.0</version>
  <description>Web dashboard (camera, GPS map, LiDAR top view, sensor health) and remote teleop with E-stop for the VLN robot. Pure stdlib HTTP server; bundles Leaflet (BSD-2).</description>
  <maintainer email="nextb@example.com">NextBG</maintainer>
  <license>MIT</license>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>nav_msgs</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>sensor_msgs_py</exec_depend>
  <exec_depend>tf2_ros</exec_depend>
  <exec_depend>ament_index_python</exec_depend>
  <exec_depend>python3-numpy</exec_depend>
  <exec_depend>python3-opencv</exec_depend>
  <exec_depend>vln_robot_client</exec_depend>
  <exec_depend>vln_robot_nav</exec_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
